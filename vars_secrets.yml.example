---
# SECRETS - do not commit. Copy this file to vars_secrets.yml and fill in.
# vars_secrets.yml is gitignored. Ideally encrypt it with ansible-vault:
#   ansible-vault encrypt vars_secrets.yml

# AAP API bearer token (create one under your user in the AAP UI, or via the API)
vault_aap_token: CHANGE_ME_AAP_API_TOKEN

# SMTP relay password / API key (leave empty if your relay needs no auth)
smtp_password: CHANGE_ME_SMTP_PASSWORD
